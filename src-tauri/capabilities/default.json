{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window uses only the explicitly allowed Rust commands. Secrets and files have no frontend plugin permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-app-state",
    "allow-switch-endpoint",
    "allow-get-public-settings",
    "allow-login",
    "allow-complete-two-factor",
    "allow-logout",
    "allow-get-groups",
    "allow-configure",
    "allow-start-stream",
    "allow-ack-stream",
    "allow-cancel-stream",
    "allow-get-engine-status"
  ]
}
